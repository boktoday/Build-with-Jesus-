{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/register",
      "destination": "/leaders",
      "permanent": false
    },
    {
      "source": "/register.html",
      "destination": "/leaders",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tencommandments.buildwithjesus.com"
        }
      ],
      "destination": "/tencommandments"
    }
  ]
}
